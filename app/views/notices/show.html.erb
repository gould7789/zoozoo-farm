<%# お知らせ詳細ページ — 本文の全文と貼られた写真を出す %>
<% content_for(:title, @notice.title) %>
<% category_label = notice_category_label(@notice.category) %>

<div class="max-w-lg md:max-w-3xl mx-auto">

  <div class="flex items-center gap-3 mb-6 bg-white/80 backdrop-blur-sm rounded-xl px-5 py-4 shadow-sm">
    <%= link_to notices_path, class: "text-gray-500 hover:text-gray-700 transition-colors shrink-0" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    <% end %>
    <h1 class="text-xl font-bold text-gray-900">공지</h1>
  </div>

  <article class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium <%= category_label[1] %>">
          <%= category_label[0] %>
        </span>
        <span class="text-xs text-gray-400"><%= @notice.created_at.strftime("%Y-%m-%d") %></span>
        <span class="text-xs text-gray-400"><%= @notice.created_by&.name || "—" %></span>
      </div>
      <% if current_user.admin? || @notice.created_by_id == current_user.id %>
        <div class="flex items-center gap-2 shrink-0">
          <%= link_to "수정", edit_notice_path(@notice), class: "text-xs text-blue-600 hover:underline" %>
          <%= button_to "삭제", notice_path(@notice),
              method: :delete,
              data: { turbo_confirm: "정말 삭제하시겠습니까?" },
              form: { class: "contents" },
              class: "text-xs text-red-500 hover:underline" %>
        </div>
      <% end %>
    </div>

    <h2 class="text-lg font-bold text-gray-900 mb-3"><%= @notice.title %></h2>

    <%# contentはActionText::RichTextで、描画時にサニタイズされる %>
    <div class="text-sm text-gray-700"><%= @notice.content %></div>
  </article>

</div>
