<%# カテゴリ別アコーディオン — hidden:falseのカテゴリのみ表示 %>
<%# turbo_streamでこのpartial全体を差し替えることでリアルタイム反映 %>
<%
  category_colors = [
    { border: "border-l-4 border-green-400",  bg: "bg-green-50"  },
    { border: "border-l-4 border-blue-400",   bg: "bg-blue-50"   },
    { border: "border-l-4 border-purple-400", bg: "bg-purple-50" },
    { border: "border-l-4 border-orange-400", bg: "bg-orange-50" },
    { border: "border-l-4 border-pink-400",   bg: "bg-pink-50"   },
  ]
%>
<% categories.each_with_index do |category, idx| %>
  <% animals = animals_by_category[category.id].presence || [] %>
  <% color = category_colors[idx % category_colors.size] %>

  <details class="bg-white rounded-xl border border-gray-200 shadow-sm mb-3 group overflow-hidden" open>
    <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none <%= color[:bg] %> <%= color[:border] %>">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <span class="font-semibold text-gray-800"><%= category.name %></span>
        <span class="text-xs text-gray-500 bg-white/70 px-2 py-0.5 rounded-full">
          <%= animals.sum(&:individual_count) %>마리
        </span>
      </div>
    </summary>

    <div class="border-t border-gray-100">

      <% if animals.empty? %>
        <%# 動物なしの場合 %>
        <p class="px-5 py-6 text-sm text-gray-400 text-center">등록된 동물이 없습니다.</p>
      <% else %>

        <%# モバイルカードリスト %>
        <div class="space-y-2 md:hidden px-4 py-3">
          <%= render partial: "zones/animal_card", collection: animals, as: :animal, locals: { zone: zone } %>
        </div>

        <%# デスクトップテーブル %>
        <div class="hidden md:block">
          <table class="w-full text-sm table-fixed">
            <thead class="bg-gray-50">
              <tr>
                <th class="w-1/4 text-left px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">종 이름</th>
                <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">개체명</th>
                <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">성별</th>
                <th class="w-1/6 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">나이</th>
                <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">건강 상태</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <%= render partial: "zones/animal_row", collection: animals, as: :animal, locals: { zone: zone } %>
            </tbody>
          </table>
        </div>

      <% end %>

    </div>
  </details>
<% end %>

<%# 動物が一頭もいない場合のメッセージ %>
<% has_any_animals = categories.any? { |c| animals_by_category[c.id].present? } || animals_by_category[nil].present? %>
<% unless has_any_animals %>
  <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
    <p class="text-gray-400 text-sm">등록된 동물이 없습니다.</p>
  </div>
<% end %>

<%# 未分類セクション %>
<% if animals_by_category[nil].present? %>
  <% uncategorized = animals_by_category[nil] %>
  <details class="bg-white rounded-xl border border-dashed border-gray-300 shadow-sm mb-3 group" open>
    <summary class="flex items-center gap-2 px-5 py-4 cursor-pointer list-none select-none">
      <svg class="w-4 h-4 text-gray-400 transition-transform group-open:rotate-90 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <span class="font-semibold text-gray-500">미분류</span>
      <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">
        <%= uncategorized.sum(&:individual_count) %>마리
      </span>
    </summary>

    <div class="border-t border-gray-100">

      <%# モバイルカードリスト %>
      <div class="space-y-2 md:hidden px-4 py-3">
        <%= render partial: "zones/animal_card", collection: uncategorized, as: :animal, locals: { zone: zone } %>
      </div>

      <%# デスクトップテーブル %>
      <div class="hidden md:block">
        <table class="w-full text-sm table-fixed">
          <thead class="bg-gray-50">
            <tr>
              <th class="w-1/4 text-left px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">종 이름</th>
              <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">개체명</th>
              <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">성별</th>
              <th class="w-1/6 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">나이</th>
              <th class="w-1/4 text-center px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">건강 상태</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <%= render partial: "zones/animal_row", collection: uncategorized, as: :animal, locals: { zone: zone } %>
          </tbody>
        </table>
      </div>

    </div>
  </details>
<% end %>
