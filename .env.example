SEED_ADMIN_EMAIL=your_admin_email@example.com
SEED_ADMIN_PASSWORD=your_password_here

# Supabase Storage (S3 protocol)
# Issue keys at: Supabase Dashboard > Project Settings > Storage > S3 access keys
# The secret is shown only once, right after creation.
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key
