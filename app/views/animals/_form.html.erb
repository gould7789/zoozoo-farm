<%# 動物登録・編集の共通フォーム %>
<%# new.html.erb と edit.html.erb から render "form" で呼び出す %>
<%= form_with model: [@zone, @animal], data: { controller: "form", action: "submit->form#submit" } do |f| %>

  <%# バリデーションエラー表示 %>
  <% if @animal.errors.any? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-sm font-medium text-red-800 mb-2">입력 오류가 있습니다.</p>
      <ul class="text-sm text-red-700 space-y-1 list-disc list-inside">
        <% @animal.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm space-y-4">

    <%# プロフィール写真 — 選択後に円形の切り抜き画面を開いてから送信する %>
    <div data-controller="photo-crop">
      <%= f.label :photo, "프로필 사진 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>

      <div class="flex items-center gap-4">
        <%# 現在の写真 — 検証エラーでの再描画時、未保存のblobはsigned_idを持たないため除外する %>
        <% has_saved_photo = @animal.photo.attached? && @animal.photo.blob.persisted? %>
        <% if has_saved_photo %>
          <%= image_tag @animal.photo.variant(:thumb),
              class: "w-20 h-20 rounded-full object-cover border border-gray-200 shrink-0",
              alt: "현재 등록된 사진",
              data: { photo_crop_target: "current" } %>
        <% end %>

        <%# 切り抜き結果のプレビュー — CSPのためblob: URLではなくcanvasに描く %>
        <canvas data-photo-crop-target="preview" width="160" height="160" hidden
                class="w-20 h-20 rounded-full border-2 border-green-500 shrink-0"></canvas>

        <div class="min-w-0 flex-1 space-y-2">
          <%= f.file_field :photo,
              accept: "image/jpeg,image/png,image/webp",
              class: "w-full text-sm text-gray-700 file:mr-3 file:h-9 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer",
              data: { photo_crop_target: "input", action: "change->photo-crop#select" } %>

          <%# 「사진 삭제」は常に画面に見えている写真に対して働く。
              保存済みの写真 → サーバーで削除（確認モーダルあり）
              未保存の選択   → 選択を取り消すだけ（失うものが無いので確認しない）
              どちらを出すかはJSが切り替える %>
          <% delete_button_class = "inline-flex items-center h-9 px-3 rounded-lg text-sm font-medium text-red-600 bg-red-50 hover:bg-red-100 transition-colors" %>

          <%# button_toはこのフォームの中に<form>を入れ子にしてしまうため、
              Turboがクリック時にbody直下へフォームを生成するlink_to + turbo_methodを使う %>
          <% if has_saved_photo %>
            <%= link_to "사진 삭제", zone_animal_photo_path(@zone, @animal),
                data: { photo_crop_target: "destroy", turbo_method: :delete, turbo_confirm: "사진을 삭제하시겠습니까?" },
                class: delete_button_class %>
          <% end %>

          <button type="button" hidden
                  data-photo-crop-target="clear"
                  data-action="photo-crop#clear"
                  class="<%= delete_button_class %>">사진 삭제</button>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-2">JPG · PNG · WEBP 형식만 등록할 수 있습니다.</p>

      <%# 切り抜き画面 — showModal()でtop layerに出すため、祖先のレイアウトに影響されない %>
      <dialog data-photo-crop-target="dialog"
              data-action="cancel->photo-crop#cancel"
              class="m-auto p-0 bg-transparent backdrop:bg-black/80">
        <div class="w-[92vw] max-w-sm bg-gray-900 rounded-2xl p-4 text-white">
          <p class="text-sm font-semibold text-center mb-3">사진 영역 선택</p>

          <canvas data-photo-crop-target="stage" width="640" height="640"
                  data-action="pointerdown->photo-crop#pointerDown pointermove->photo-crop#pointerMove pointerup->photo-crop#pointerUp pointercancel->photo-crop#pointerUp wheel->photo-crop#wheel:!passive"
                  class="w-full aspect-square rounded-xl touch-none cursor-move"></canvas>

          <div class="flex items-center gap-3 mt-4">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.2-5.2M10.5 7.5v6m-3-3h6M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
            </svg>
            <input type="range" min="1" max="4" step="0.01" value="1"
                   data-photo-crop-target="zoom"
                   data-action="input->photo-crop#zoomInput"
                   aria-label="확대"
                   class="w-full accent-green-500">
          </div>
          <p class="text-xs text-gray-400 text-center mt-2">드래그로 위치를 옮기고, 슬라이더나 휠로 확대하세요.</p>

          <div class="grid grid-cols-2 gap-3 mt-4">
            <button type="button" data-action="photo-crop#cancel"
                    class="h-11 rounded-lg bg-gray-700 hover:bg-gray-600 text-sm font-medium transition-colors">취소</button>
            <button type="button" data-action="photo-crop#confirm"
                    class="h-11 rounded-lg bg-green-600 hover:bg-green-700 text-sm font-medium transition-colors">완료</button>
          </div>
        </div>
      </dialog>
    </div>

    <div>
      <%= f.label :species, "종 이름", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :species,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500",
          placeholder: "예: 라쿤" %>
    </div>

    <div>
      <%# 個体名は任意（多頭飼育種は空白のまま） %>
      <%= f.label :name, "개체명 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500",
          placeholder: "예: 오몽이 (여러 마리인 경우 비워도 됩니다)" %>
    </div>

    <%# カテゴリ選択 — 同じ館内のカテゴリのみ表示 %>
    <div>
      <%= f.label :animal_category_id, "카테고리 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :animal_category_id,
          @categories.map { |c| [ c.name, c.id ] },
          { include_blank: "— 미분류 —" },
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 bg-white" %>
    </div>

    <%# 個体数 — 多頭種（ウサギ・モルモット等）の頭数管理 %>
    <div>
      <%= f.label :individual_count, "개체 수", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :individual_count,
          min: 1,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500" %>
      <p class="text-xs text-gray-400 mt-1">개별 이름이 없는 동물 종의 경우 총 마리 수를 입력해주세요.</p>
    </div>

    <div>
      <%= f.label :gender, "성별", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :gender,
          [["수컷", "male"], ["암컷", "female"], ["미확인", "unknown"]],
          {},
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 bg-white" %>
    </div>

    <div>
      <%# 生年月日は不明の場合は空白 %>
      <%= f.label :birth_date, "생년월일 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :birth_date,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500" %>
      <p class="text-xs text-gray-400 mt-1">생년월일을 모르는 경우 입수일을 참고해 입력해주세요.</p>
    </div>

    <div>
      <%= f.label :acquired_at, "입수일 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :acquired_at,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500" %>
    </div>

    <div>
      <%= f.label :acquisition_note, "입수 경위 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :acquisition_note,
          rows: 3,
          class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 resize-none overflow-hidden",
          placeholder: "예: 구매, 기증, 자연번식 등",
          data: { controller: "textarea", action: "input->textarea#resize" } %>
    </div>

    <div>
      <%# CITES区分 — 許可証の実物は書類で保管、システムには区分のみ記録 %>
      <%= f.label :cites_grade, "CITES 등급", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :cites_grade,
          [["해당 없음", "none"], ["부속서 I", "grade_i"], ["부속서 II", "grade_ii"], ["부속서 III", "grade_iii"]],
          {},
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 bg-white" %>
    </div>

    <div>
      <%# 先天性疾患・性格など固定の特記事項 %>
      <%= f.label :note, "특이사항 (선택)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :note,
          rows: 3,
          class: "w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 resize-none overflow-hidden",
          placeholder: "선천적 기형, 성격 등 고정 특이사항",
          data: { controller: "textarea", action: "input->textarea#resize" } %>
    </div>

  </div>

  <div class="mt-4 flex flex-col gap-3">
    <%= f.submit @animal.persisted? ? "저장" : "등록",
        class: "w-full h-11 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer",
        data: { form_target: "submit" } %>
    <%= link_to "취소", @animal.persisted? ? zone_animal_path(@zone, @animal) : zone_path(@zone),
        class: "w-full h-11 inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>

<% end %>
