<%# 공지 폼 (new/edit 공용) — 판단 근거는 notes/notice.md %>
<%= form_with model: notice, data: { controller: "form", action: "submit->form#submit" } do |f| %>

  <% if notice.errors.any? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-sm font-medium text-red-800 mb-2">입력 오류가 있습니다.</p>
      <ul class="text-sm text-red-700 space-y-1 list-disc list-inside">
        <% notice.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm space-y-4">

    <div>
      <%= f.label :category, "카테고리", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category,
          [
            ["전체 공지", "general"],
            ["사랑새관", "lovebird"],
            ["앵무새관", "parrot"],
            ["파충류관", "reptile"],
            ["미니동물관", "small_animal"],
            ["야외동물체험관", "outdoor"],
            ["격리실", "isolation"]
          ],
          {},
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500 bg-white" %>
    </div>

    <div>
      <%= f.label :title, "제목", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title,
          maxlength: 100,
          class: "w-full h-11 px-3 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-green-500",
          placeholder: "공지 제목을 입력하세요" %>
    </div>

    <div>
      <%= f.label :content, "내용", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%# Trix 툴바와 에디터 본체의 모양은 app/assets/tailwind/application.css 에서 맞춘다 —
          여기에 class 를 더해도 Trix 가 만드는 내부 요소에는 닿지 않는다 %>
      <%# blob_url_template 의 기본값은 리다이렉트 경로라 img_src :self 에 막힌다.
          다른 이미지와 같이 proxy 경로로 맞춘다 (notes/notice.md) %>
      <%= f.rich_text_area :content,
          placeholder: "공지 내용을 입력하세요",
          data: {
            controller: "image-downscale",
            action: "trix-attachment-add->image-downscale#attach",
            blob_url_template: rails_service_blob_proxy_url(":signed_id", ":filename")
          } %>
    </div>

  </div>

  <div class="mt-4 flex flex-col gap-3">
    <%= f.submit notice.persisted? ? "저장" : "작성",
        class: "w-full h-11 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer",
        data: { form_target: "submit" } %>
    <%= link_to "취소", notices_path,
        class: "w-full h-11 inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>

<% end %>
