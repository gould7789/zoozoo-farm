<%# 공지 목록 %>
<% content_for(:title, "공지 목록") %>

<div class="max-w-2xl md:max-w-4xl mx-auto">

  <div class="flex items-center justify-between mb-6 bg-white/80 backdrop-blur-sm rounded-xl px-5 py-4 shadow-sm">
    <h1 class="text-xl font-bold text-gray-900">공지 목록</h1>
    <%= link_to new_notice_path,
        class: "inline-flex items-center gap-1.5 h-9 px-3 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      공지 작성
    <% end %>
  </div>

  <%# 카테고리 필터를 링크로 만든다 — 서버에서 거르므로
      새로고침·뒤로가기·URL 공유가 그대로 동작한다.
      가로 스크롤은 관이 7개라 모바일 폭에 안 들어가기 때문 %>
  <nav class="flex gap-2 overflow-x-auto pb-2 mb-4 -mx-1 px-1 [scrollbar-width:none]">
    <%# general 의 라벨이 「전체」라 필터 없음은 「모두」로 둔다.
        나란히 두면 「전체」가 두 개 떠서 어느 쪽이 필터 없음인지 모른다 %>
    <% categories = Notice.categories.keys.map { |key| [ key, key == "general" ? "전체 공지" : notice_category_label(key)[0] ] } %>
    <% [ [ nil, "모두" ] ].concat(categories).each do |key, label| %>
      <% selected = @category == key %>
      <%= link_to label, notices_path(category: key),
          class: "shrink-0 inline-flex items-center h-9 px-3.5 rounded-full text-sm font-medium transition-colors #{selected ? 'bg-green-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50'}" %>
    <% end %>
  </nav>

  <% if @notices.empty? %>
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <p class="text-gray-500 text-sm"><%= @category ? "이 관의 공지가 없습니다." : "공지가 없습니다." %></p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @notices.each do |notice| %>
        <% category_label = notice_category_label(notice.category) %>

        <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium <%= category_label[1] %>">
                <%= category_label[0] %>
              </span>
              <span class="text-xs text-gray-500"><%= notice.created_at.strftime("%Y-%m-%d") %></span>
              <span class="text-xs text-gray-500"><%= notice.created_by&.name || "—" %></span>
            </div>
            <% if current_user.admin? || notice.created_by_id == current_user.id %>
              <div class="flex items-center gap-2 shrink-0">
                <%= link_to "수정", edit_notice_path(notice),
                    class: "text-xs text-blue-600 hover:underline" %>
                <%= button_to "삭제", notice_path(notice),
                    method: :delete,
                    data: { turbo_confirm: "정말 삭제하시겠습니까?" },
                    form: { class: "contents" },
                    class: "text-xs text-red-500 hover:underline" %>
              </div>
            <% end %>
          </div>
          <%# 목록은 제목과 발췌만. 본문과 사진은 상세에서 낸다 —
              전문을 늘어놓으면 카드 높이가 들쭉날쭉해 읽기 어렵다 %>
          <%= link_to notice_path(notice), class: "block group" do %>
            <h2 class="text-base font-bold text-gray-900 mb-1 group-hover:text-green-700 transition-colors">
              <%= notice.title %>
            </h2>
            <% if notice.excerpt.present? %>
              <p class="text-sm text-gray-700 line-clamp-2"><%= notice.excerpt %></p>
            <% end %>
            <% if notice.photo_count.positive? %>
              <span class="inline-flex items-center gap-1 mt-2 text-xs text-gray-500">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M18 14.25h.008v.008H18v-.008zM2.25 6.75v10.5a2.25 2.25 0 002.25 2.25h15a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25h-15a2.25 2.25 0 00-2.25 2.25z" />
                </svg>
                사진 <%= notice.photo_count %>장
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
