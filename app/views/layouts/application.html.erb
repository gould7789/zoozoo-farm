<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "| #{content_for(:title)}" : "| 동물원 관리 시스템" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Zoo Zoo Farm">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/tap_logo.png" type="image/png">
    <link rel="apple-touch-icon" href="/tap_logo.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# 모바일과 데스크톱에서 배경 이미지를 바꾼다 %>
  <body class="min-h-screen zoo-bg">

    <%= render "layouts/flash" %>

    <%# turbo_confirm 의 확인 다이얼로그 — body 바로 아래에 하나만 둔다 %>
    <%= render "layouts/confirm_dialog" %>

    <% if logged_in? %>
      <div class="hidden md:flex md:fixed md:inset-y-0 md:w-64 md:flex-col md:bg-white md:border-r md:border-gray-200 md:z-30">
        <%= render "layouts/sidebar" %>
      </div>

      <%# 모바일 상단 로고 헤더 — lg 미만에서만 보인다 %>
      <div class="md:hidden flex justify-center pt-2 pb-1">
        <%= link_to zones_path, class: "inline-block" do %>
          <%= image_tag "main_logo.png", alt: "Zoo Zoo Farm", class: "h-48 w-auto drop-shadow-md hover:opacity-90 transition-opacity" %>
        <% end %>
      </div>
    <% end %>

    <main class="<%= logged_in? ? 'md:ml-64 pb-20 md:pb-0 px-4 md:px-8 pt-2 md:pt-6' : '' %> min-h-screen">
      <%= yield %>
    </main>

    <% if logged_in? %>
      <%# 모바일 하단 탭 바 — lg 이상에서는 숨긴다 %>
      <nav class="md:hidden fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 z-30">
        <%= render "layouts/bottom_nav" %>
      </nav>
    <% end %>

    <%# 모달은 body 바로 아래에 둔다 — fixed 가 뷰포트 기준으로 동작해야 한다 %>
    <%= yield :modal %>

  </body>
</html>
