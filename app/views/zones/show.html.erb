<%# 관 상세 — 카테고리별 아코디언. 구조는 notes/zone-accordion.md %>
<% content_for(:title) { @zone.name } %>

<div class="max-w-2xl md:max-w-4xl mx-auto">

  <%# relative z-30 — backdrop-blur 가 쌓임 맥락을 만들어 메뉴 패널의 z-index 가
    이 카드 밖으로 못 나간다. 카드째 올려야 뒤의 검색창 위에 그려진다 (common/views.md) %>
  <div class="relative z-30 flex items-center justify-between mb-4 bg-white/80 backdrop-blur-sm rounded-xl px-5 py-4 shadow-sm">
    <div class="flex items-center gap-3 min-w-0">
      <%= link_to zones_path, class: "text-gray-500 hover:text-gray-700 transition-colors shrink-0" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      <% end %>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900 truncate"><%= @zone.name %></h1>
        <% if @zone.description.present? %>
          <p class="text-sm text-gray-500 mt-0.5 line-clamp-1"><%= @zone.description %></p>
        <% end %>
      </div>
    </div>
    <% if current_user.admin? %>
      <%# 주 동작(추가)만 밖에 두고 보조 동작은 메뉴로 접는다.
          375px 에서 버튼 3개가 폭을 다 먹어 관 이름이 0px 로 눌렸다 %>
      <div class="flex items-center gap-2 shrink-0 ml-3">
        <%= link_to new_zone_animal_path(@zone),
            class: "inline-flex items-center gap-1.5 h-9 px-3 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          추가
        <% end %>

        <%= render layout: "shared/action_menu" do %>
          <%= link_to zone_animals_path(@zone, format: :xlsx), class: menu_item_class do %>
            <%= render "shared/excel_icon" %>
            Excel
          <% end %>
          <%# 모달이 body 직하라 Outlet 으로 참조한다 %>
          <button type="button"
                  data-controller="modal-opener"
                  data-modal-opener-modal-outlet="#category-modal"
                  data-action="click->modal-opener#open"
                  class="<%= menu_item_class %>">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.559.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.272-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            카테고리 관리
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# 검색 필드와 아코디언을 함께 search 컨트롤러로 감싼다 %>
  <div data-controller="search">

    <div class="relative mb-4">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <input type="text"
             placeholder="종 이름 또는 개체명으로 검색"
             class="w-full h-10 pl-9 pr-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 bg-white"
             data-search-target="input"
             data-action="input->search#filter">
    </div>

    <%# id 는 turbo_stream 의 교체 대상이라는 뜻이다 %>
    <div id="category_accordion">
      <%= render "zones/accordion",
          zone: @zone,
          categories: @categories,
          animals_by_category: @animals_by_category %>
    </div><%# / #category_accordion %>

    <p data-search-target="empty" class="hidden text-center text-gray-500 text-sm py-8">검색 결과가 없습니다.</p>

  </div><%# / data-controller="search" %>

  <%# 카테고리 관리 모달을 body 직하에 — fixed 를 뷰포트 기준으로 (common/views.md) %>
  <% if current_user.admin? %>
    <% content_for :modal do %>
      <div data-controller="modal" id="category-modal">

        <div data-modal-target="overlay"
             data-action="click->modal#closeOnOverlay"
             class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-40">
        </div>

        <%# 모달 패널 — 화면 가운데 %>
        <div data-modal-target="panel"
             class="hidden fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-[90vw] max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden">

          <div class="flex items-center justify-between px-6 py-5 bg-green-50 border-b border-green-200">
            <div>
              <h2 class="text-base font-bold text-green-900">카테고리 관리</h2>
              <p class="text-xs text-green-600 mt-0.5"><%= @zone.name %></p>
            </div>
            <button data-action="click->modal#close"
                    class="text-green-600 hover:text-green-900 transition-colors p-1">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <%# id 는 turbo_stream 이 입력 칸을 비우는 대상이다 %>
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">새 카테고리 추가</p>
            <div id="category_add_form">
              <%= form_with model: [@zone, AnimalCategory.new] do |f| %>
                <div class="flex gap-2">
                  <%= f.text_field :name,
                      placeholder: "카테고리 이름",
                      class: "flex-1 h-10 px-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 bg-white" %>
                  <%= f.submit "추가",
                      class: "h-10 px-5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer" %>
                </div>
                <p id="category_add_error" class="mt-1 text-xs text-red-500"></p>
              <% end %>
            </div>
          </div>

          <%# id 는 turbo_stream 의 교체 대상이다 %>
          <div id="modal_category_list" class="max-h-80 overflow-y-auto divide-y divide-gray-100">
            <% if @all_categories.empty? %>
              <p class="px-6 py-8 text-center text-sm text-gray-500">등록된 카테고리가 없습니다.</p>
            <% else %>
              <% @all_categories.sort_by { |c| [c.hidden? ? 1 : 0, c.name] }.each do |category| %>
                <%= render "animal_categories/category_row", category: category, zone: @zone %>
              <% end %>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  <% end %>

</div>
